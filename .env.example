# Copy to .env; never commit real keys or personal searches.
# OpenAI-compatible inference endpoint, e.g. an operator-managed local server.
BUYWATCHER_AI_BASE_URL=
BUYWATCHER_AI_MODEL=
BUYWATCHER_AI_API_KEY=
BUYWATCHER_AI_TIMEOUT=120
# For compatible local reasoning models; leave blank for other providers.
BUYWATCHER_AI_REASONING_EFFORT=
# Set only to a model that accepts image_url input.
BUYWATCHER_VISION_MODEL=
BUYWATCHER_MAX_AI_PER_RUN=40
BUYWATCHER_MAX_DETAILS_PER_SOURCE=30
# Retains the original Verona scope. Enable only after verifying permitted access.
BUYWATCHER_ENABLE_SUBITO=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Separate, explicit policy confirmations; do not enable just because keys work.
EBAY_ANALYSIS_ALLOWED=false
# Optional: default uses SUBITO_DB, then subito.db (Docker: /data/subito.db).
# BUYWATCHER_DB=/data/subito.db
